function wednesday_sendPrescreeningEmails() {
  var sheet = SpreadsheetApp.openById("1IrBrC-vYm44fpm4soEiQIkNSYp2CUOhj9AQgetotGx8").getSheetByName("Pre-screening tracker");
  var data = sheet.getDataRange().getValues();
  var headers = data[0];
  var siteIndex = headers.indexOf("Please choose your site number");
  var timestampIndex = headers.indexOf("Date of form submission");

  var siteData = {};

  // Define sites to be excluded from emails
  var excludedSites = ["1210", "1606"];

  // Define recipient groups with at least 5 recipients each
  var recipients = {
    "1208": "csapo.alexandra.klaudia@semmelweis.hu, gyongyi.gesztelyi@viacrystal.com",
    "1209": "vrancsik.zsofia@med.unideb.hu, gyongyi.gesztelyi@viacrystal.com",
    "1210": "pavel.shkliaev@viacrystal.com",
    "1211": "valeria.montsko@gmail.com, gyongyi.gesztelyi@viacrystal.com",
    "1212": "kalomistakrisztina@gmail.com, gyongyi.gesztelyi@viacrystal.com",
    "1213": "sara.ilonczai@clinexpert.hu, gyongyi.gesztelyi@viacrystal.com",
    "1601": "nemstep@gmail.com, ivan.ugrinovic@viacrystal.com",
    "1603": "vucurevicbojan75@gmail.com, jovanpetrovic1997@gmail.com, ivan.ugrinovic@viacrystal.com",
    "1604": "drkoncar@gmail.com, anicailic87@yahoo.com, ivan.ugrinovic@viacrystal.com",
    "1605": "zvezdan.stefanovic@gmail.com, uros92jankovic@gmail.com, ivan.ugrinovic@viacrystal.com",
    "1606": "dragankg984@gmail.com, vanja.skg@gmail.com, ivan.ugrinovic@viacrystal.com"
  };

  // Group data by site number and find the latest entry
  for (var i = 1; i < data.length; i++) {
    var row = data[i];
    var siteNumber = row[siteIndex] ? row[siteIndex].toString() : null;
    if (!siteNumber) continue;

    var timestamp = new Date(row[timestampIndex]);

    if (!siteData[siteNumber] || timestamp > siteData[siteNumber].timestamp) {
      siteData[siteNumber] = { timestamp: timestamp, row: row };
    }
  }

  var currentDate = new Date();

  for (var site in siteData) {
    var latestTimestamp = siteData[site].timestamp;
    var diffTime = currentDate - latestTimestamp;
    var diffDays = Math.round(diffTime / (1000 * 3600 * 24)); // Correct rounding

    if (diffDays <= 2) continue;
    if (!recipients[site] || excludedSites.includes(site)) continue;

    var latestRow = siteData[site].row;
    var emailBody = "";
    var subject = ("1208,1209,1210,1211,1212,1213".includes(site))
      ? `MRXC-302 Kérjük, töltse ki az előszűrési űrlapot - Site ${site}`
      : `MRXC-302 Zamolili bismo Vas da popunite Prescreening formular - Site ${site}`;

    emailBody = ("1208,1209,1210,1211,1212,1213".includes(site))
      ? "<p>Tisztelt Vizsgálati Csapat!</p><p>Kérjük, szíveskedjenek válaszolni néhány kérdésre az elmúlt héten vizsgálóhelyükön végzett előszűrési tevékenységekkel kapcsolatban.</p>"
      : "<p>Dragi clanovi studijskog tima,</p><p>Ljubazno vas molimo da odgovorite na nekoliko pitanja u vezi sa aktivnostima pre-skrininga koje su sprovedene na vašem centru tokom protekle nedelje.</p>";

    emailBody += "<p><a href='https://docs.google.com/forms/d/e/1FAIpQLSdSbwcZ0GCLXQq-ATBsGY0f0-QnWAo6QA1Kjiw1TlIGzEw0Mw/viewform?usp=header'>Molimo popunite obrazac</a></p>";
    emailBody += "<p>Ako imate bilo kakvih pitanja, molimo kontaktirajte monitora.</p><p>U nastavku pronađite odgovore date od poslednjeg puta:</p><ul>";

    for (var j = 0; j < headers.length; j++) {
      if (["Please enter verification code", "Please choose your site number"].includes(headers[j])) continue;
      var value = latestRow[j];
      if (headers[j] === "Date of form submission") {
        value = Utilities.formatDate(new Date(value), Session.getScriptTimeZone(), "dd MMM yyyy");
      }
      emailBody += `<li><strong>${headers[j]}:</strong> ${value}</li>`;
    }
    emailBody += "</ul><p>Thank you.</p>";

    MailApp.sendEmail({
      to: recipients[site],
      subject: subject,
      htmlBody: emailBody
    });
  }
}
